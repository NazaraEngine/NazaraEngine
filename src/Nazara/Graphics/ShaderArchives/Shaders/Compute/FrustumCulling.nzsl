[nzsl_version("1.1")]
module Compute.FrustumCulling;

import Engine.FrustumPlane;
import Engine.IndirectData;
import InstanceBuffer from Engine.InstanceData;
import ViewerData from Engine.ViewerData;

option WorkgroupSize: u32 = 256;

[layout(std430)]
struct IndirectDraw
{
	drawCommand: IndirectData.DrawIndexedIndirectCommand,
	aabb: IndirectData.AABB,
}

[layout(std430)]
struct DrawIndexedIndirectCommandBuffer
{
	drawIndirects: dyn_array[IndirectDraw]
}

[auto_binding]
external
{
	indirectBuffer: storage[DrawIndexedIndirectCommandBuffer, readwrite],
	instanceBuffer: storage[InstanceBuffer, readonly],
	viewerData: uniform[ViewerData],
}

fn TestPlaneAgainstBox(plane: vec4[f32], center: vec3[f32], extent: vec3[f32]) -> bool
{
	// https://fgiesen.wordpress.com/2010/10/17/view-frustum-culling/
	return dot(center + extent * sign(plane.xyz), plane.xyz) >= -plane.w;
}

fn FrustumCull(center: vec3[f32], extent: vec3[f32]) -> bool
{
	let visible = true;
	visible &&= TestPlaneAgainstBox(viewerData.frustumPlanes[FrustumPlane.Bottom], center, extent);
	visible &&= TestPlaneAgainstBox(viewerData.frustumPlanes[FrustumPlane.Left], center, extent);
	visible &&= TestPlaneAgainstBox(viewerData.frustumPlanes[FrustumPlane.Right], center, extent);
	visible &&= TestPlaneAgainstBox(viewerData.frustumPlanes[FrustumPlane.Top], center, extent);

	if (!isinf(viewerData.nearPlane))
		visible &&= TestPlaneAgainstBox(viewerData.frustumPlanes[FrustumPlane.Near], center, extent);

	if (!isinf(viewerData.farPlane))
		visible &&= TestPlaneAgainstBox(viewerData.frustumPlanes[FrustumPlane.Far], center, extent);

	return visible;
}

struct Input
{
	[builtin(global_invocation_indices)] invocationIndices: vec3[u32]
}

const boundingBoxCorners = array(
	vec3[f32](0.0, 0.0, 0.0),
	vec3[f32](0.0, 0.0, 1.0),
	vec3[f32](0.0, 1.0, 0.0),
	vec3[f32](0.0, 1.0, 1.0),
	vec3[f32](1.0, 0.0, 0.0),
	vec3[f32](1.0, 0.0, 1.0),
	vec3[f32](1.0, 1.0, 0.0),
	vec3[f32](1.0, 1.0, 1.0)
);

[entry(comp), workgroup(WorkgroupSize, 1, 1)]
fn main(input: Input)
{
	let commandCount = indirectBuffer.drawIndirects.Size();
	let commandIndex = input.invocationIndices.x;
	if (commandIndex >= commandCount)
		return;

	let drawData = indirectBuffer.drawIndirects[commandIndex];
	let instanceIndex = drawData.drawCommand.firstInstance;

	let worldMatrix = instanceBuffer.instances[instanceIndex].worldMatrix;

	let aabbOrigin = vec3[f32](drawData.aabb.params[0], drawData.aabb.params[1], drawData.aabb.params[2]);
	let aabbSize = vec3[f32](drawData.aabb.params[3], drawData.aabb.params[4], drawData.aabb.params[5]);

	let aabbMins = (f32.Infinity).xxx;
	let aabbMaxs = -aabbMins;

	[unroll]
	for cornerFactor in boundingBoxCorners
	{
		let localCornerPos = aabbOrigin + aabbSize * cornerFactor;
		let worldCornerPos = worldMatrix * vec4[f32](localCornerPos, 1.0);

		aabbMaxs = max(aabbMaxs, worldCornerPos.xyz);
		aabbMins = min(aabbMins, worldCornerPos.xyz);
	}

	let center = 0.5 * (aabbMins + aabbMaxs);
	let extent = 0.5 * (aabbMaxs - aabbMins);

	let isVisible = FrustumCull(center, extent);

	indirectBuffer.drawIndirects[commandIndex].drawCommand.instanceCount = select(isVisible, u32(1), u32(0));
}
